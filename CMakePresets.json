{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 30,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Development",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "APPELLATE_ENABLE_LINUX_PACKAGING": "OFF"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON",
        "APPELLATE_ENABLE_LINUX_PACKAGING": "ON"
      }
    },
    {
      "name": "asan",
      "displayName": "Address and undefined behavior sanitizers",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/asan",
      "cacheVariables": {
        "APPELLATE_ENABLE_ASAN": "ON",
        "APPELLATE_ENABLE_UBSAN": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "e2e",
      "displayName": "Local desktop end-to-end tests",
      "configurePreset": "dev",
      "environment": {
        "QT_QPA_PLATFORM": "offscreen"
      },
      "filter": {
        "include": {
          "label": "e2e"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "high-dpi",
      "displayName": "2x high-DPI UI tests",
      "configurePreset": "dev",
      "filter": {
        "include": {
          "label": "high-dpi"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "packaging",
      "displayName": "Local Linux install and relocation tests",
      "configurePreset": "release",
      "environment": {
        "QT_QPA_PLATFORM": "offscreen"
      },
      "filter": {
        "include": {
          "label": "packaging"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
