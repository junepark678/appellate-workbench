{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appellate-workbench.invalid/schemas/v2/authority-set.schema.json",
  "title": "Versioned legal authority set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "resource_kind", "resource_id", "source_cutoff", "authorities"],
  "properties": {
    "schema_version": { "const": 2 },
    "resource_kind": { "const": "authority_set" },
    "resource_id": { "$ref": "common.schema.json#/$defs/namespaced_id" },
    "source_cutoff": { "type": "string", "format": "date" },
    "authorities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2048,
      "items": { "$ref": "common.schema.json#/$defs/authority_ref" }
    }
  }
}
