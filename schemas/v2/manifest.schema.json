{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appellate-workbench.invalid/schemas/v2/manifest.schema.json",
  "title": "Appellate Workbench content-pack manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack_id",
    "version",
    "required_capabilities",
    "dependencies",
    "contents",
    "blobs"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "pack_id": { "$ref": "#/$defs/namespaced_id" },
    "version": { "$ref": "#/$defs/semver" },
    "required_capabilities": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version"],
        "properties": {
          "id": { "$ref": "#/$defs/namespaced_id" },
          "version": { "type": "integer", "minimum": 1, "maximum": 65535 }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pack_id", "version", "sha256"],
        "properties": {
          "pack_id": { "$ref": "#/$defs/namespaced_id" },
          "version": { "$ref": "#/$defs/semver" },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "contents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "schema_version", "path", "sha256"],
        "properties": {
          "id": { "$ref": "#/$defs/namespaced_id" },
          "kind": {
            "enum": [
              "argument_config",
              "authority_set",
              "bench_configuration",
              "case",
              "court",
              "filing_catalog",
              "form",
              "judge_profile",
              "procedure_profile",
              "realism_review",
              "record",
              "workflow"
            ]
          },
          "schema_version": { "const": 2 },
          "path": { "$ref": "#/$defs/portable_path" },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "blobs": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "media_type", "byte_size", "sha256"],
        "properties": {
          "path": { "$ref": "#/$defs/portable_path" },
          "media_type": { "const": "application/pdf" },
          "byte_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 536870912
          },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  },
  "$defs": {
    "namespaced_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+(?:[-.][a-z0-9]+)*$"
    },
    "portable_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9_-])?(?:/[a-z0-9](?:[a-z0-9._-]*[a-z0-9_-])?)*$"
    },
    "semver": {
      "type": "string",
      "minLength": 5,
      "maxLength": 128,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
