{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appellate-workbench.invalid/schemas/v2/argument-config.schema.json",
  "title": "Oral-argument configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "resource_kind", "resource_id", "case_id", "bench_configuration_id", "total_seconds", "rebuttal_seconds", "permitted_issue_ids"],
  "properties": {
    "schema_version": { "const": 2 },
    "resource_kind": { "const": "argument_config" },
    "resource_id": { "$ref": "common.schema.json#/$defs/namespaced_id" },
    "case_id": { "$ref": "common.schema.json#/$defs/namespaced_id" },
    "bench_configuration_id": { "$ref": "common.schema.json#/$defs/namespaced_id" },
    "total_seconds": { "type": "integer", "minimum": 60, "maximum": 7200 },
    "rebuttal_seconds": { "type": "integer", "minimum": 0, "maximum": 1800 },
    "permitted_issue_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/namespaced_id" }
    },
    "grounded_question_bank": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "grounding_digest",
        "issue_topic_bindings",
        "questions"
      ],
      "properties": {
        "mode": { "enum": ["actual_record", "counterfactual_training"] },
        "grounding_digest": { "$ref": "common.schema.json#/$defs/sha256" },
        "issue_topic_bindings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["issue_id", "topic_ids"],
            "properties": {
              "issue_id": { "$ref": "common.schema.json#/$defs/namespaced_id" },
              "topic_ids": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/focus_topic_id" }
              }
            }
          }
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "question_id",
              "issue_id",
              "topic_id",
              "prompt",
              "grounding"
            ],
            "properties": {
              "question_id": { "$ref": "common.schema.json#/$defs/namespaced_id" },
              "issue_id": { "$ref": "common.schema.json#/$defs/namespaced_id" },
              "topic_id": { "$ref": "#/$defs/focus_topic_id" },
              "prompt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^(?![\\x{0000}-\\x{0020}\\x{007F}])(?:[^\\x{0000}-\\x{001F}\\x{007F}]*[^\\x{0000}-\\x{0020}\\x{007F}])?$"
              },
              "grounding": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": { "$ref": "#/$defs/grounding_ref" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "focus_topic_id": {
      "enum": [
        "workbench.topic.jurisdiction",
        "workbench.topic.preservation",
        "workbench.topic.standard-of-review",
        "workbench.topic.record-support",
        "workbench.topic.governing-authority",
        "workbench.topic.merits",
        "workbench.topic.remedy",
        "workbench.topic.practical-consequences"
      ]
    },
    "grounding_ref": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["grounding_id", "kind", "authority_id"],
          "properties": {
            "grounding_id": { "$ref": "common.schema.json#/$defs/namespaced_id" },
            "kind": { "const": "authority" },
            "authority_id": { "$ref": "common.schema.json#/$defs/namespaced_id" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["grounding_id", "kind", "entry_id", "page_number"],
          "properties": {
            "grounding_id": { "$ref": "common.schema.json#/$defs/namespaced_id" },
            "kind": { "const": "brief_page" },
            "entry_id": { "$ref": "common.schema.json#/$defs/namespaced_id" },
            "page_number": { "type": "integer", "minimum": 1, "maximum": 10000 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["grounding_id", "kind", "anchor_id"],
          "properties": {
            "grounding_id": { "$ref": "common.schema.json#/$defs/namespaced_id" },
            "kind": { "const": "record_page" },
            "anchor_id": { "$ref": "common.schema.json#/$defs/namespaced_id" }
          }
        }
      ]
    }
  }
}
