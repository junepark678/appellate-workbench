{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appellate-workbench.invalid/schemas/v2/record.schema.json",
  "title": "Synthetic lower-tribunal record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "resource_kind", "resource_id", "caption", "docket_entries"],
  "properties": {
    "schema_version": { "const": 2 },
    "resource_kind": { "const": "record" },
    "resource_id": { "$ref": "common.schema.json#/$defs/namespaced_id" },
    "caption": { "type": "string", "minLength": 1, "maxLength": 512 },
    "dockets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["docket_id", "docket_type", "court_ref", "public_docket_number", "caption"],
        "properties": {
          "docket_id": { "$ref": "common.schema.json#/$defs/namespaced_id" },
          "docket_type": {
            "type": "string",
            "enum": ["district", "appellate", "agency", "original"]
          },
          "court_id": { "$ref": "common.schema.json#/$defs/namespaced_id" },
          "court_ref": { "type": "string", "minLength": 1, "maxLength": 240 },
          "public_docket_number": { "type": "string", "minLength": 1, "maxLength": 120 },
          "caption": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      }
    },
    "docket_entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entry_id", "entry_number", "filed_on", "title", "asset_path", "asset_sha256", "page_count", "sealed"],
        "properties": {
          "entry_id": { "$ref": "common.schema.json#/$defs/namespaced_id" },
          "entry_number": { "type": "integer", "minimum": 1 },
          "docket_id": { "$ref": "common.schema.json#/$defs/namespaced_id" },
          "entry_label": { "type": "string", "minLength": 1, "maxLength": 120 },
          "filed_on": { "type": "string", "format": "date" },
          "title": { "type": "string", "minLength": 1, "maxLength": 512 },
          "actor": { "type": "string", "minLength": 1, "maxLength": 240 },
          "description": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "tags": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 64 }
          },
          "parent_entry_id": { "$ref": "common.schema.json#/$defs/namespaced_id" },
          "relationship": {
            "type": "string",
            "enum": ["attachment", "amendment", "supplement", "component"]
          },
          "asset_path": { "$ref": "common.schema.json#/$defs/portable_path" },
          "asset_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
          "page_count": { "type": "integer", "minimum": 1, "maximum": 10000 },
          "sealed": { "type": "boolean" }
        }
      }
    },
    "page_anchors": {
      "type": "array",
      "maxItems": 32768,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["anchor_id", "entry_id", "page_number"],
        "properties": {
          "anchor_id": { "$ref": "common.schema.json#/$defs/namespaced_id" },
          "entry_id": { "$ref": "common.schema.json#/$defs/namespaced_id" },
          "page_number": { "type": "integer", "minimum": 1, "maximum": 10000 },
          "citation_label": { "type": "string", "minLength": 1, "maxLength": 120 }
        }
      }
    }
  }
}
