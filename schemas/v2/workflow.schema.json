{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appellate-workbench.invalid/schemas/v2/workflow.schema.json",
  "title": "Typed legal workflow",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "resource_kind",
    "resource_id",
    "initial_stage_id",
    "stages",
    "operations",
    "filing_routes",
    "calendar"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "resource_kind": { "const": "workflow" },
    "resource_id": { "$ref": "common.schema.json#/$defs/namespaced_id" },
    "initial_stage_id": { "$ref": "common.schema.json#/$defs/namespaced_id" },
    "stages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/namespaced_id" }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "stage_id",
          "opcode",
          "authority",
          "authorized_role_ids"
        ],
        "properties": {
          "operation_id": { "$ref": "common.schema.json#/$defs/namespaced_id" },
          "stage_id": { "$ref": "common.schema.json#/$defs/namespaced_id" },
          "opcode": {
            "enum": [
              "accept_filing",
              "reject_filing",
              "issue_deficiency",
              "calculate_deadline",
              "enter_order",
              "advance_stage",
              "set_sealed",
              "schedule_argument",
              "issue_judgment",
              "issue_mandate"
            ]
          },
          "authority": { "$ref": "common.schema.json#/$defs/authority_basis" },
          "next_stage_id": { "$ref": "common.schema.json#/$defs/namespaced_id" },
          "deadline_days": { "type": "integer", "minimum": 0, "maximum": 3650 },
          "deadline_counting": { "enum": ["calendar_days", "business_days"] },
          "authorized_role_ids": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": { "$ref": "common.schema.json#/$defs/namespaced_id" }
          }
        }
      }
    },
    "filing_routes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2048,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "filing_type_id",
          "stage_id",
          "authorized_role_ids",
          "required_field_ids",
          "required_service_role_ids",
          "accept_operation_id",
          "reject_operation_id",
          "reject_after_deadline"
        ],
        "properties": {
          "filing_type_id": { "$ref": "common.schema.json#/$defs/namespaced_id" },
          "stage_id": { "$ref": "common.schema.json#/$defs/namespaced_id" },
          "authorized_role_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": { "$ref": "common.schema.json#/$defs/namespaced_id" }
          },
          "required_field_ids": {
            "type": "array",
            "maxItems": 256,
            "uniqueItems": true,
            "items": { "$ref": "common.schema.json#/$defs/namespaced_id" }
          },
          "required_service_role_ids": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": { "$ref": "common.schema.json#/$defs/namespaced_id" }
          },
          "accept_operation_id": { "$ref": "common.schema.json#/$defs/namespaced_id" },
          "reject_operation_id": { "$ref": "common.schema.json#/$defs/namespaced_id" },
          "deficiency_operation_id": { "$ref": "common.schema.json#/$defs/namespaced_id" },
          "deficiency_deadline": { "$ref": "#/$defs/deadline_plan" },
          "accepted_deadline": { "$ref": "#/$defs/deadline_plan" },
          "advance_operation_id": { "$ref": "common.schema.json#/$defs/namespaced_id" },
          "satisfies_deadline_id": { "$ref": "common.schema.json#/$defs/namespaced_id" },
          "reject_after_deadline": { "type": "boolean" }
        }
      }
    },
    "calendar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["holidays"],
      "properties": {
        "holidays": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": { "type": "string", "format": "date" }
        }
      }
    }
  },
  "$defs": {
    "deadline_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deadline_id", "operation_id"],
      "properties": {
        "deadline_id": { "$ref": "common.schema.json#/$defs/namespaced_id" },
        "operation_id": { "$ref": "common.schema.json#/$defs/namespaced_id" }
      }
    }
  }
}
