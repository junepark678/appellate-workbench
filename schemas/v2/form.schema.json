{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appellate-workbench.invalid/schemas/v2/form.schema.json",
  "title": "Declarative filing form",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "resource_kind", "resource_id", "filing_id", "title", "fields"],
  "properties": {
    "schema_version": { "const": 2 },
    "resource_kind": { "const": "form" },
    "resource_id": { "$ref": "common.schema.json#/$defs/namespaced_id" },
    "filing_id": { "$ref": "common.schema.json#/$defs/namespaced_id" },
    "title": { "type": "string", "minLength": 1, "maxLength": 240 },
    "fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field_id", "label", "value_type", "required"],
        "properties": {
          "field_id": { "$ref": "common.schema.json#/$defs/namespaced_id" },
          "label": { "type": "string", "minLength": 1, "maxLength": 240 },
          "value_type": { "enum": ["short_text", "long_text", "boolean", "date", "choice", "record_citation", "authority_citation"] },
          "required": { "type": "boolean" },
          "choices": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 240 }
          }
        }
      }
    }
  }
}
