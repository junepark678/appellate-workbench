{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appellate-workbench.invalid/schemas/v1/bench-configuration.schema.json",
  "title": "One-or-more-seat bench configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "resource_kind", "resource_id", "court_id", "presiding_seat_id", "seats"],
  "properties": {
    "schema_version": { "const": 1 },
    "resource_kind": { "const": "bench_configuration" },
    "resource_id": { "$ref": "common.schema.json#/$defs/namespaced_id" },
    "court_id": { "$ref": "common.schema.json#/$defs/namespaced_id" },
    "presiding_seat_id": { "$ref": "common.schema.json#/$defs/namespaced_id" },
    "seats": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["seat_id", "profile_id", "court_role"],
        "properties": {
          "seat_id": { "$ref": "common.schema.json#/$defs/namespaced_id" },
          "profile_id": { "$ref": "common.schema.json#/$defs/namespaced_id" },
          "court_role": { "enum": ["district", "appellate"] }
        }
      }
    }
  }
}
