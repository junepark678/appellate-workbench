{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appellate-workbench.invalid/schemas/v1/workflow.schema.json",
  "title": "Typed legal workflow",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "resource_kind", "resource_id", "initial_stage_id", "stages", "operations"],
  "properties": {
    "schema_version": { "const": 1 },
    "resource_kind": { "const": "workflow" },
    "resource_id": { "$ref": "common.schema.json#/$defs/namespaced_id" },
    "initial_stage_id": { "$ref": "common.schema.json#/$defs/namespaced_id" },
    "stages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/namespaced_id" }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation_id", "stage_id", "opcode", "authority_id"],
        "properties": {
          "operation_id": { "$ref": "common.schema.json#/$defs/namespaced_id" },
          "stage_id": { "$ref": "common.schema.json#/$defs/namespaced_id" },
          "opcode": {
            "enum": [
              "accept_filing",
              "reject_filing",
              "issue_deficiency",
              "calculate_deadline",
              "enter_order",
              "advance_stage",
              "set_sealed",
              "schedule_argument",
              "issue_judgment",
              "issue_mandate"
            ]
          },
          "authority_id": { "$ref": "common.schema.json#/$defs/namespaced_id" },
          "next_stage_id": { "$ref": "common.schema.json#/$defs/namespaced_id" },
          "deadline_days": { "type": "integer", "minimum": 0, "maximum": 3650 },
          "deadline_counting": { "enum": ["calendar_days", "business_days"] }
        }
      }
    }
  }
}
