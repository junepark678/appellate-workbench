set(_appellate_allow_development "@APPELLATE_ALLOW_UNVERIFIED_DEVELOPMENT_PACKAGE@")
set(_appellate_expected_revision "@APPELLATE_RELEASE_SOURCE_REVISION@")
set(_appellate_expected_tag "v@PROJECT_VERSION@")
set(_appellate_expected_fingerprint "@APPELLATE_RELEASE_SIGNING_FINGERPRINT@")

if(_appellate_allow_development)
    set(
        CPACK_PACKAGE_FILE_NAME
        "appellate-workbench-@PROJECT_VERSION@-linux-x86_64-development-unverified"
    )
    message(
        AUTHOR_WARNING
        "Creating an explicitly unverified development package; it is not publishable"
    )
    return()
endif()

string(LENGTH "${_appellate_expected_fingerprint}" _appellate_fingerprint_length)
if(NOT _appellate_fingerprint_length EQUAL 40 OR
   NOT _appellate_expected_fingerprint MATCHES "^[0-9A-Fa-f]+$")
    message(FATAL_ERROR "A 40-hex APPELLATE_RELEASE_SIGNING_FINGERPRINT is required")
endif()
string(TOUPPER "${_appellate_expected_fingerprint}" _appellate_expected_fingerprint)

execute_process(
    COMMAND "@GIT_EXECUTABLE@" status --porcelain=v1 --untracked-files=normal
    WORKING_DIRECTORY "@PROJECT_SOURCE_DIR@"
    RESULT_VARIABLE _appellate_status_result
    OUTPUT_VARIABLE _appellate_status
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_VARIABLE _appellate_status_error
)
if(NOT _appellate_status_result EQUAL 0 OR NOT _appellate_status STREQUAL "")
    message(
        FATAL_ERROR
        "Release packaging requires a clean source tree:\n"
        "${_appellate_status}\n${_appellate_status_error}"
    )
endif()

execute_process(
    COMMAND "@GIT_EXECUTABLE@" rev-parse HEAD^{commit}
    WORKING_DIRECTORY "@PROJECT_SOURCE_DIR@"
    RESULT_VARIABLE _appellate_head_result
    OUTPUT_VARIABLE _appellate_head
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_VARIABLE _appellate_head_error
)
if(NOT _appellate_head_result EQUAL 0 OR
   NOT _appellate_head STREQUAL _appellate_expected_revision)
    message(
        FATAL_ERROR
        "Release source revision mismatch: expected ${_appellate_expected_revision}, "
        "found ${_appellate_head}. ${_appellate_head_error}"
    )
endif()

execute_process(
    COMMAND "@GIT_EXECUTABLE@" rev-parse "refs/tags/${_appellate_expected_tag}^{commit}"
    WORKING_DIRECTORY "@PROJECT_SOURCE_DIR@"
    RESULT_VARIABLE _appellate_tag_result
    OUTPUT_VARIABLE _appellate_tag_revision
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_VARIABLE _appellate_tag_error
)
if(NOT _appellate_tag_result EQUAL 0 OR NOT _appellate_tag_revision STREQUAL _appellate_head)
    message(
        FATAL_ERROR
        "Release tag ${_appellate_expected_tag} must resolve exactly to HEAD: "
        "${_appellate_tag_error}"
    )
endif()

execute_process(
    COMMAND "@GIT_EXECUTABLE@" verify-tag --raw "${_appellate_expected_tag}"
    WORKING_DIRECTORY "@PROJECT_SOURCE_DIR@"
    RESULT_VARIABLE _appellate_verify_result
    OUTPUT_VARIABLE _appellate_verify_output
    ERROR_VARIABLE _appellate_verify_error
)
set(_appellate_verify_text "${_appellate_verify_output}\n${_appellate_verify_error}")
string(
    REGEX MATCH
    "\\[GNUPG:\\] VALIDSIG ([0-9A-Fa-f]+)"
    _appellate_validsig
    "${_appellate_verify_text}"
)
if(NOT _appellate_verify_result EQUAL 0 OR NOT _appellate_validsig)
    message(FATAL_ERROR "Release tag signature verification failed: ${_appellate_verify_text}")
endif()
string(TOUPPER "${CMAKE_MATCH_1}" _appellate_actual_fingerprint)
if(NOT _appellate_actual_fingerprint STREQUAL _appellate_expected_fingerprint)
    message(
        FATAL_ERROR
        "Release tag was signed by ${_appellate_actual_fingerprint}, not the configured key"
    )
endif()
