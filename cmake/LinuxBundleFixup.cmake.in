function(_appellate_set_serialized_literal output encoded)
    string(LENGTH "${encoded}" _encoded_length)
    if(_encoded_length LESS 2)
        message(FATAL_ERROR "Serialized CMake literal is missing its sentinels")
    endif()
    math(EXPR _decoded_length "${_encoded_length} - 2")
    string(SUBSTRING "${encoded}" 1 "${_decoded_length}" _decoded)
    set("${output}" "${_decoded}" PARENT_SCOPE)
endfunction()

_appellate_set_serialized_literal(_appellate_install_libdir @APPELLATE_RELEASE_LITERAL_OPEN@x@CMAKE_INSTALL_LIBDIR@x@APPELLATE_RELEASE_LITERAL_CLOSE@)
_appellate_set_serialized_literal(_appellate_patchelf_executable @APPELLATE_RELEASE_LITERAL_OPEN@x@APPELLATE_PATCHELF_EXECUTABLE@x@APPELLATE_RELEASE_LITERAL_CLOSE@)

set(_appellate_bundle_library_dir
    "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/${_appellate_install_libdir}"
)
file(GLOB _appellate_bundle_libraries
    LIST_DIRECTORIES FALSE
    "${_appellate_bundle_library_dir}/*.so*"
)
foreach(_appellate_library IN LISTS _appellate_bundle_libraries)
    if(IS_SYMLINK "${_appellate_library}")
        continue()
    endif()
    execute_process(
        COMMAND
            "${_appellate_patchelf_executable}"
            --set-rpath "$ORIGIN"
            "${_appellate_library}"
        RESULT_VARIABLE _appellate_patchelf_result
        ERROR_VARIABLE _appellate_patchelf_error
    )
    if(NOT _appellate_patchelf_result EQUAL 0)
        message(
            FATAL_ERROR
            "Cannot make ${_appellate_library} relocatable: "
            "${_appellate_patchelf_error}"
        )
    endif()
endforeach()
